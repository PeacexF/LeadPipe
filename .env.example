# Host default. Inside docker compose this is overridden to the postgres service.
DATABASE_URL=postgresql+asyncpg://leadpipe:leadpipe@localhost:5432/leadpipe

# Integration tests
TEST_DATABASE_URL=

CONFIG_PATH=examples/configs/all.yaml

API_HOST=0.0.0.0
API_PORT=8000

# admin endpoints
LEADPIPE_API_KEY=

# comma separated, empty disables CORS
CORS_ORIGINS=

LOG_LEVEL=INFO
LOG_FORMAT=console
